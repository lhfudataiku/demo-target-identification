# Local-dev overrides — copy to .env and fill in. Never commit .env.
#
# The Makefile loads app.env first, then .env on top.
# Use this file to override PROJECT_KEY for a local test project,
# or to supply DSS credentials if ~/.dataiku/config.json is absent.

# Override the project to query locally (optional — defaults to app.env PROJECT_KEY)
# PROJECT_KEY=MY_LOCAL_TEST_PROJECT

# Visual Graph Explorer (the default target is the validated project webapp).
# The app uses the current DSS origin when embedded; set this only for local
# development when the Explorer lives on a different DSS host.
# VITE_VISUAL_GRAPH_PROJECT_KEY=DEMO_TARGET_IDENTIFICATION
# VITE_VISUAL_GRAPH_WEBAPP_ID=wBcApLN
# VITE_VISUAL_GRAPH_OBJECT_ID=wBcApLN_graph-search
# VITE_DSS_ORIGIN=https://my-dss-instance.example.com

# Direct DSS credentials (only needed if ~/.dataiku/config.json is not set up)
# DSS_URL=https://my-dss-instance.example.com
# DSS_API_KEY=my_api_key_here

# Port overrides (optional)
# BACKEND_PORT=5001
# FRONTEND_PORT=5174

# ── Building block overrides (optional) ───────────────────────────────────────
# These default to 0 in app.env.  Override here for a local dev session
# without committing the change.  One line per flag (Vite reads ENABLE_* directly).
# ENABLE_DOCUMENTS=1
# ENABLE_CHATBOT=1
# ENABLE_DESCRIBE=1
