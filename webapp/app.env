# ──────────────────────────────────────────────────────────────────────────────
# Per-application config — single source of truth.
#
# These six identity/target values ship EMPTY on purpose. Fill them in directly:
#   LIB_NS, APP_PREFIX, VITE_APP_NAME, ENV_NAME, DKU_INSTANCE, PROJECT_KEY
# `make dev` refuses to start until they are set (it lists any that are missing).
# DKU_INSTANCE is the instance name from ~/.dataiku/config.json (see `dku whoami`).
# That's the whole setup — no code edits needed; the display name and FastAPI
# title read VITE_APP_NAME, and the sidebar icon is a fixed brand mark.
#
# Sourced by:
#   - Makefile    (dev ports, deploy target, the "configured?" gate on `make dev`)
#   - deploy.sh   (LIB_NS, PROJECT_KEY, WEBAPP_ID, ENV_NAME)
#   - dss_webapp/backend.py reads LIB_NS + APP_PREFIX at deploy time
#   - backend/config.py reads APP_PREFIX from process env (set by Makefile / DSS)
# ──────────────────────────────────────────────────────────────────────────────

# Library namespace: must be a valid Python package name (lowercase, underscores).
# Used as the path under python/ in the DSS project library.
#
# The redesign moved into the original webapp at the Phase 8 switch-over (2026-10-27,
# archive/WEBAPP_REDESIGN_WORKPLAN.md §10). The preview webapp and its library folder were
# deleted the same day.
LIB_NS=target_prioritizer

# Environment-variable prefix (UPPER_SNAKE). Keeps env vars namespaced per app.
APP_PREFIX=TARGET_PRIORITIZER

# App display name (shown in the sidebar header).
VITE_APP_NAME=Target Prioritizer

# ── DSS target ────────────────────────────────────────────────────────────────
# Set by the wizard; required before `make dev` (local DSS queries) or `make deploy`.

# DSS instance name from ~/.dataiku/config.json (set by the init wizard).
DKU_INSTANCE=default

# DSS project key (uppercase). Used by deploy.sh and local dss_client fallback.
PROJECT_KEY=DEMO_TARGET_IDENTIFICATION

# Visual Graph Explorer target. The production URL uses the current DSS origin;
# set VITE_DSS_ORIGIN in webapp/.env for local development against a DSS host.
# DSS navigation uses the object ID; backend status and log APIs use the webapp ID.
VITE_VISUAL_GRAPH_PROJECT_KEY=DEMO_TARGET_IDENTIFICATION
VITE_VISUAL_GRAPH_WEBAPP_ID=wBcApLN
VITE_VISUAL_GRAPH_OBJECT_ID=wBcApLN_graph-explorer
VITE_DSS_ORIGIN=

# Agent Hub webapp the candidate card's "Explore in Agent Hub" link opens (workplan Phase 7b).
# Empty hides the link. The object ID is the webapp's ID plus its name slug, as in its DSS URL.
VITE_AGENT_HUB_PROJECT_KEY=DEMO_TARGET_IDENTIFICATION
VITE_AGENT_HUB_OBJECT_ID=bFyW6D2_agent-hub

# Webapp ID — leave empty to auto-create the webapp on first deploy (the
# generated ID is written back here automatically). Or paste an existing
# webapp's ID to deploy into it directly.
WEBAPP_ID=OlmPX9a

# Code environment name on the DSS instance (Python 3.11+ recommended).
ENV_NAME=demo_kg-drug-discovery

# ── Local dev ports ───────────────────────────────────────────────────────────
# Keep BACKEND_PORT at 5000: frontend/vite.config.ts hardcodes the /api proxy
# target to 127.0.0.1:5000. Changing it here alone breaks local dev with an
# ECONNREFUSED that surfaces in the UI as an unexplained HTTP 500.
BACKEND_PORT=5000
FRONTEND_PORT=5173
